---
layout: base.njk
nav: work
---
{#- A project page: intro, optional images beside the text, then optional sections
    (shows, build steps…), each with its own text and images/videos. Empty parts are skipped. -#}
<section>
  <a class="back" href="index.html">← Work</a>
  <h2 class="ptitle">{{ title }}</h2>
  {%- if lede %}
  <p class="lede">{{ lede }}</p>
  {%- endif %}

  {%- set body = content | trim %}
  {%- if (media | withFile).length %}
  <div class="hero2">
    {%- set items = media %}{% include "media.njk" %}
    {%- if body %}<div class="prose">{{ body | safe }}</div>{% endif %}
  </div>
  {%- elif body %}
  <div class="prose">{{ body | safe }}</div>
  {%- endif %}

  {%- if sections and sections.length %}
  {%- if sections_heading %}
  <div class="sechead"><h2>{{ sections_heading }}</h2><span class="mono muted">{{ sections.length }}</span></div>
  {%- endif %}
  {#- a rail of every section stays beside the content while scrolling and marks the one in view #}
  <div class="timeline">
    <nav class="rail" aria-label="Sections">
      <ol>
        {%- for s in sections %}
        <li><a href="#s{{ loop.index }}"><span class="when">{{ s.meta or s.label }}</span><span class="what">{{ s.title }}</span></a></li>
        {%- endfor %}
      </ol>
      <span class="marker" aria-hidden="true"></span>
    </nav>
    <div class="entries">
      {%- for s in sections %}
      <article class="entry" id="s{{ loop.index }}">
        <header class="entry-head">
          <span class="mono muted">{{ s.label }}{% if s.label and s.meta %} · {% endif %}{{ s.meta }}</span>
          <h3>{{ s.title }}</h3>
        </header>
        {%- set items = s.media %}{% include "reel.njk" %}
        <div class="entry-text">{{ s.text | md | safe }}</div>
      </article>
      {%- endfor %}
    </div>
  </div>
  {%- endif %}
</section>
