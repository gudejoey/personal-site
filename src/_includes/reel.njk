{#- One section's images/videos: a lead frame that crossfades between items, with a thumbnail
    row to pick one (only when there is more than one). Expects `items` (list of { file, alt, caption }).
    Nothing is output when the list is empty. -#}
{%- set shown = items | withFile %}
{%- if shown.length %}
<div class="reel">
  <div class="lead">
    {%- for m in shown %}
    <figure class="slide{% if loop.first %} on{% endif %}"{% if not loop.first %} aria-hidden="true"{% endif %} data-caption="{{ m.caption }}">
      {%- if m.file | isVideo %}
      <video src="{{ m.file }}" muted loop playsinline preload="metadata"{% if m.alt %} aria-label="{{ m.alt }}"{% endif %}></video>
      {%- else %}
      <button type="button" aria-label="Enlarge image"{% if not loop.first %} tabindex="-1"{% endif %}><img src="{{ m.file }}" alt="{{ m.alt }}" loading="lazy"></button>
      {%- endif %}
    </figure>
    {%- endfor %}
  </div>
  {%- if shown.length > 1 %}
  <div class="thumbs" role="group" aria-label="Choose image">
    {%- for m in shown %}
    <button type="button" class="thumb{% if loop.first %} on{% endif %}" aria-pressed="{{ 'true' if loop.first else 'false' }}" aria-label="Show {{ loop.index }} of {{ shown.length }}">
      {%- if m.file | isVideo %}<video src="{{ m.file }}#t=0.1" muted playsinline preload="metadata"></video><span class="play" aria-hidden="true">▶</span>
      {%- else %}<img src="{{ m.file }}" alt="" loading="lazy">{% endif -%}
    </button>
    {%- endfor %}
    <span class="count mono muted"><span class="n">1</span> / {{ shown.length }}</span>
  </div>
  {%- endif %}
  <p class="reel-cap mono muted"{% if not shown[0].caption %} hidden{% endif %}>{{ shown[0].caption }}</p>
</div>
{%- endif %}
