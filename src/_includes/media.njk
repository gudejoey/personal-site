{#- Renders a list of images/videos. Expects `items` (list of { file, alt, caption }).
    Nothing is output when the list is empty, so there are never placeholder boxes. -#}
{%- set shown = items | withFile %}
{%- if shown.length %}
<div class="media{% if shown.length > 1 %} many{% endif %}">
  {%- for m in shown %}
  <figure>
    {%- if m.file | isVideo %}
    <video src="{{ m.file }}" autoplay muted loop playsinline{% if m.alt %} aria-label="{{ m.alt }}"{% endif %}></video>
    {%- else %}
    <button type="button" aria-label="Enlarge image"><img src="{{ m.file }}" alt="{{ m.alt }}" loading="lazy"></button>
    {%- endif %}
    {%- if m.caption %}<figcaption>{{ m.caption }}</figcaption>{% endif %}
  </figure>
  {%- endfor %}
</div>
{%- endif %}
